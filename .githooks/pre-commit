#!/usr/bin/env bash
# ==============================================================================
# SOTA Skills Ecosystem - Pre-Commit Governance Hook
# Garante não-regressão, integridade SHA-256 e conformidade com os 8 Vetores SOTA.
# ==============================================================================

set -e

WORKSPACE_DIR="$(git rev-parse --show-toplevel)"
cd "$WORKSPACE_DIR"

# Resolução dinâmica dos scripts de auditoria e RAG
if [ -f "scripts/audit_engine.py" ]; then
    AUDIT_SCRIPT="scripts/audit_engine.py"
elif [ -f ".github/scripts/audit_engine.py" ]; then
    AUDIT_SCRIPT=".github/scripts/audit_engine.py"
else
    AUDIT_SCRIPT=""
fi

if [ -f "scripts/skills_rag_indexer.py" ]; then
    RAG_INDEXER="scripts/skills_rag_indexer.py"
elif [ -f ".github/scripts/skills_rag_indexer.py" ]; then
    RAG_INDEXER=".github/scripts/skills_rag_indexer.py"
else
    RAG_INDEXER=""
fi

GOVERNANCE_INDEX=".github/governance/AUDIT_MASTER_INDEX.md"

# Se o repositório atual não contiver o script de auditoria de skills, prossegue normalmente
if [ -z "$AUDIT_SCRIPT" ]; then
    exit 0
fi

echo "================================================================================"
echo "🛡️  SOTA SKILLS GOVERNANCE - PRE-COMMIT AUDIT & INTEGRITY CHECK"
echo "================================================================================"

# 1. Normalizar quebras de linha (CRLF -> LF) nos arquivos em staging
echo "[*] Normalizing line endings across staged files..."
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM || true)

if [ -n "$STAGED_FILES" ]; then
    python3 -c "
import sys, pathlib
for arg in sys.argv[1:]:
    p = pathlib.Path(arg)
    if p.is_file():
        try:
            b = p.read_bytes()
            if b'\r\n' in b:
                p.write_bytes(b.replace(b'\r\n', b'\n'))
        except Exception:
            pass
" $STAGED_FILES 2>/dev/null || true
fi

# 1.5. Auto-Tradução para Inglês (ADR-026) quando PT-BR/outro idioma for detectado em skills/
TRANSLATE_SCRIPT=""
if [ -f "scripts/translate_catalog_nim.py" ]; then
    TRANSLATE_SCRIPT="scripts/translate_catalog_nim.py"
elif [ -f ".github/scripts/translate_catalog_nim.py" ]; then
    TRANSLATE_SCRIPT=".github/scripts/translate_catalog_nim.py"
fi

if [ -n "$TRANSLATE_SCRIPT" ]; then
    SKILL_STAGED=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^skills/.*\.(md|py|sh|ts|js)$' || true)
    if [ -n "$SKILL_STAGED" ]; then
        echo "[*] Verificando detecção de idioma e auto-tradução para EN-US (ADR-026)..."
        python3 "$TRANSLATE_SCRIPT" > /tmp/precommit_translate.log 2>&1 || {
            echo "⚠️  [WARN] Auto-tradução ignorada (NIM offline ou erro no pipeline)."
        }
        echo "✅ [PASS] Verificação de idioma / auto-tradução concluída."
    fi
fi

# 2. Executar validação forense e integridade
echo "[*] Executing Forensic Audit Engine ($AUDIT_SCRIPT)..."
python3 "$AUDIT_SCRIPT" > /tmp/precommit_audit.log 2>&1 || {
    echo "❌ [FAIL] Audit Engine encountered an error:"
    cat /tmp/precommit_audit.log
    exit 1
}

# Auto-stage arquivos de governança atualizados pela auditoria
if [ -d ".github/governance" ]; then
    git add .github/governance/
fi

# 3. Validar se algum ativo está em AVISO ou CRÍTICA no índice de governança
if [ -f "$GOVERNANCE_INDEX" ]; then
    WARN_COUNT=$(grep -o "AVISO" "$GOVERNANCE_INDEX" 2>/dev/null | wc -l || echo 0)
    CRIT_COUNT=$(grep -o "CRÍTICA" "$GOVERNANCE_INDEX" 2>/dev/null | wc -l || echo 0)

    if [ "$CRIT_COUNT" -gt 0 ]; then
        echo "❌ [BLOCK] Commit rejected: $CRIT_COUNT asset(s) with CRÍTICA status detected!"
        exit 1
    fi

    if [ "$WARN_COUNT" -gt 0 ]; then
        echo "⚠️  [WARN] Notice: $WARN_COUNT asset(s) with AVISO status detected."
    fi

    echo "✅ [PASS] All assets verified against 8-Dimension SOTA Framework."
else
    echo "ℹ️  [INFO] Governance index ($GOVERNANCE_INDEX) not found. Skipping grep check."
fi

# 4. Gatilho Inteligente: Sincronização automática do RAG se houver alteração em skills
SKILL_CHANGES=$(git diff --cached --name-only | grep -E '^([^/]+/(SKILL\.md|.*\.py|.*\.json|.*\.md)|plugins/|skills/)' | grep -vE '^(README|CHANGELOG|USAGE|RELEASE-NOTES|STATE|AGENTS|GEMINI|docs/|\.github/|\.githooks/)' || true)

if [ -n "$SKILL_CHANGES" ] && [ -n "$RAG_INDEXER" ]; then
    echo "[*] Alterações em skills detectadas. Sincronizando banco RAG dedicado ($RAG_INDEXER)..."
    python3 "$RAG_INDEXER" > /tmp/precommit_rag.log 2>&1 || {
        echo "⚠️  [WARN] RAG Indexer avisou:"
        cat /tmp/precommit_rag.log
    }
    echo "✅ [PASS] Dedicated Skills RAG DB sincronizado."
fi

# 5. Sincronização e Auditoria do Ledger Contínuo SOTA (skill-audit-bulletin)
LEDGER_SCRIPT="skills/skill-audit-bulletin/scripts/update_audit_ledger.py"
if [ -f "$LEDGER_SCRIPT" ]; then
    echo "[*] Sincronizando Continuous Skill Audit Ledger SOTA ($LEDGER_SCRIPT)..."
    python3 "$LEDGER_SCRIPT" --sync-all > /tmp/precommit_ledger.log 2>&1 || {
        echo "⚠️  [WARN] Falha na sincronização do ledger (consulte /tmp/precommit_ledger.log)"
    }
    if [ -d "docs/audit/skills" ]; then
        git add docs/audit/skills/
    fi
    echo "✅ [PASS] Continuous Skill Audit Ledger sincronizado."
fi

echo "================================================================================"
echo "✨ Pre-Commit Governance Check Passed! Proceeding with commit."
echo "================================================================================"
exit 0